[repositories]
  local
  maven-local

  # Bintray shut down in May 2021. The typesafe-maven / typesafe-ivy /
  # sbtplugin / jcenter entries that used to live here all pointed at
  # dl.bintray.com and jcenter.bintray.com and can no longer resolve.
  # Artifacts that used to be typesafe-only are on Maven Central now.
  aliyun-maven: https://maven.aliyun.com/repository/public
  maven-central
  typesafe-maven: https://repo.typesafe.com/typesafe/maven-releases/, [organization]/[module]/(scala_[scalaVersion]/)(sbt_[sbtVersion]/)[revision]/[type]s/[artifact](-[classifier]).[ext]
  sbt-plugin-releases: https://repo.scala-sbt.org/scalasbt/sbt-plugin-releases/, [organization]/[module]/(scala_[scalaVersion]/)(sbt_[sbtVersion]/)[revision]/[type]s/[artifact](-[classifier]).[ext]
  apache: https://repository.apache.org/content/repositories/releases
  atlassian: https://maven.atlassian.com/repository/public
  sonatype: https://oss.sonatype.org/content/groups/public