<ivy-settings>
  <property name="local-maven2-pattern" value="${user.home}/.m2/repository/[organisation]/[module]/[revision]/[module]-[revision]" override="false" />

  <settings defaultResolver="main" />
    <caches repositoryCacheDir="${user.home}/.ivy2/cache">
    <cache name="nocache" useOrigin="true" />
    <cache name="default" />
  </caches>

  <!--
    Bintray shut down in May 2021. The dl.bintray.com/typesafe and
    jcenter.bintray.com resolvers that used to live here can no longer
    resolve; typesafe artifacts moved to Maven Central / repo.typesafe.com.
  -->
  <resolvers>
    <chain name="main">
      <filesystem name="local-maven-2" m2compatible="true" local="true" cache="nocache">
        <ivy pattern="${local-maven2-pattern}.pom" />
        <artifact pattern="${local-maven2-pattern}(-[classifier]).[ext]" />
      </filesystem>
      <ibiblio name="aliyun" m2compatible="true" root="https://maven.aliyun.com/repository/public/" cache="default"/>
      <ibiblio name="maven-central" m2compatible="true" root="https://repo1.maven.org/maven2/" cache="default"/>
      <ibiblio name="typesafe" m2compatible="true" root="https://repo.typesafe.com/typesafe/maven-releases/" cache="default"/>
      <ibiblio name="apache" m2compatible="true" root="https://repository.apache.org/content/repositories/releases" cache="default"/>
    </chain>
  </resolvers>
</ivy-settings>