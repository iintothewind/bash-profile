prefix=/Users/ivar/.npm/modules
cache=/Users/ivar/.npm/cache
registry=https://registry.npmmirror.com
# npm.taobao.org was retired in favour of registry.npmmirror.com; the old
# host now redirects and node-dist tarball URLs built from it can 404.
disturl=https://registry.npmmirror.com/-/binary/node
# export NODE_TLS_REJECT_UNAUTHORIZED=0
strict-ssl=false