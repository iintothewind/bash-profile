<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 http://maven.apache.org/xsd/settings-1.2.0.xsd">
  <pluginGroups>
    <pluginGroup>org.mortbay.jetty</pluginGroup>
    <pluginGroup>org.sonatype.maven.plugins</pluginGroup>
  </pluginGroups>

  <!--
    Credentials intentionally live here, not in this file.

    This repo is synced to $HOME by .shell/sync.sh, but .m2 is NOT in the
    sync list, so ~/.m2/settings.xml is a manual copy of this template.
    Keep it that way and do not commit secrets.

    Put real credentials in ~/.m2/settings-security.xml (outside the repo):
      <settingsSecurity>
        <master>{encrypted}</master>
      </settingsSecurity>

    and reference the server id here without a <password> element. If you
    prefer env vars instead, the ${env.VAR} form is also supported, e.g.
    <username>${env.RAPTOR_USER}</username>
  -->

  <mirrors>
    <!--
      Block plain-HTTP repositories. This MUST stay blocked=true: with
      blocked=false Maven resolves the mirror URL below (a black hole at
      0.0.0.0) and every http:// repository fails to download.

      Note this used to be followed by two more mirrors also using
      mirrorOf=external:http:*, which could never take effect -- Maven
      uses only the first matching mirror. Those entries are gone; the
      repositories below are all HTTPS now.
    -->
    <mirror>
      <id>maven-default-http-blocker</id>
      <mirrorOf>external:http:*</mirrorOf>
      <name>pseudo</name>
      <url>http://0.0.0.0/</url>
      <blocked>true</blocked>
    </mirror>
  </mirrors>

  <profiles>
    <profile>
      <id>default</id>
      <properties>
        <downloadSources>true</downloadSources>
        <!--<downloadJavadocs>true</downloadJavadocs>-->
      </properties>
      <repositories>
        <repository>
          <id>aliyun-release</id>
          <url>https://maven.aliyun.com/repository/public</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
          <releases>
            <enabled>true</enabled>
          </releases>
        </repository>
        <repository>
          <id>central</id>
          <url>https://repo1.maven.org/maven2</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
          <releases>
            <enabled>true</enabled>
          </releases>
        </repository>
        <repository>
          <id>oss</id>
          <url>https://oss.sonatype.org/content/groups/public</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
          <releases>
            <enabled>true</enabled>
          </releases>
        </repository>
      </repositories>

      <pluginRepositories>
        <pluginRepository>
          <id>aliyun-plugins</id>
          <url>https://maven.aliyun.com/repository/public</url>
        </pluginRepository>
        <pluginRepository>
          <id>central</id>
          <url>https://repo1.maven.org/maven2</url>
        </pluginRepository>
      </pluginRepositories>
    </profile>

    <!-- Activate with -Pcentral to bypass Aliyun and use only Maven Central. -->
    <profile>
      <id>central</id>
      <repositories>
        <repository>
          <id>central</id>
          <url>https://repo1.maven.org/maven2</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
          <releases>
            <enabled>true</enabled>
          </releases>
        </repository>
      </repositories>

      <pluginRepositories>
        <pluginRepository>
          <id>central</id>
          <url>https://repo1.maven.org/maven2</url>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>

  <activeProfiles>
    <activeProfile>default</activeProfile>
  </activeProfiles>
</settings>